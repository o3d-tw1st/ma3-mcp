# MA3-MCP Configuration
# Copy this file to .env and adjust paths for your system

# =============================================================================
# IPC Communication Paths
# =============================================================================
# Directory for command/response files (shared between Python and Lua plugin)
# Defaults: macOS=/Users/Shared/MA3, Windows=C:/ProgramData/MA3, Linux=/tmp/ma3
# MA3_IPC_DIR=/Users/Shared/MA3

# Or set individual file paths:
# MA3_COMMAND_FILE=/Users/Shared/MA3/mcp_command.txt
# MA3_RESPONSE_FILE=/Users/Shared/MA3/mcp_response.txt

# =============================================================================
# Plugin Deployment (for deploy.sh)
# =============================================================================
# Path to the MA3 plugin directory where mcp_server.lua will be deployed
# This is typically: ~/MALightingTechnology/gma3_X.X.X/shared/resource/lib_plugins/mcp_server
# The script will auto-detect if not set, but you can override:
# MA3_PLUGIN_DIR=/path/to/MALightingTechnology/gma3_2.3.2/shared/resource/lib_plugins/mcp_server

# =============================================================================
# OSC Configuration (for deploy.sh reload)
# =============================================================================
# OSC host and port for sending reload commands to MA3
# MA3_OSC_HOST=127.0.0.1
# MA3_OSC_PORT=8000

# NetBird HTTP bridge (run_netbird_http.py / start-onpc-with-mcp.ps1)
# MA3_HTTP_HOST=0.0.0.0
# MA3_HTTP_PORT=8765
