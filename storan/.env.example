# Storan WS1 overrides (copy to storan/.env or repo .env)

# IPC (defaults: C:/ProgramData/MA3 on Windows)
# MA3_IPC_DIR=C:/ProgramData/MA3

# Logs and screenshots
# STORAN_LOG=C:/Users/o3d/Development/Storan-GMa3/exports/mcp_session.log
# STORAN_SHOT_DIR=C:/Users/o3d/Development/Storan-GMa3/exports/shots
# STORAN_LUA_LOG=C:/ProgramData/MA3/storan_lua_log.txt

# onPC binary (used by start-onpc-with-mcp.ps1)
# GMA3_BIN=C:/Program Files/MALightingTechnology/gma3_2.3.2/bin/app_gma3.exe

# Dimmer MVR on WS1
# STORAN_MVR_DIMMER=C:/Users/o3d/Development/Storan-GMa3/exports/dimmers.mvr
